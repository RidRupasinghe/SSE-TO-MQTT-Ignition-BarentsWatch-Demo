# Copy to .env only if you do not already have one; keep real credentials in .env.
# Based on the local configuration, with credential values replaced.
# Get an AIS-client at https://www.barentswatch.no/minside/
AUTHENTICATION_URL=https://id.barentswatch.no/connect/token
CLIENT_ID=your-barentswatch-client-id
CLIENT_SECRET=your-barentswatch-client-secret
CLIENT_SCOPE=ais
STREAMING_ENDPOINT=https://live.ais.barentswatch.no/live/v1/sse/combined
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC=ais
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=choose-a-local-mqtt-password
CONNECTIONS_CONFIG=config/connections.json
